{
  "globalSetup": "<rootDir>/global-setup.ts",
  "moduleFileExtensions": ["js", "json", "ts"],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  },
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "testTimeout": 15000,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
