# Copy this to .env.development or .env.production
# Never commit your .env files to git!

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Server
PORT=3000

# Uploads (max image file size in MB)
UPLOAD_DIR="uploads"
UPLOAD_MAX_SIZE=5

# JSON authentication
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"
JWT_EXPIRES_IN="24h"

# Advert constraints
ADVERT_PAGE_MIN=1
ADVERT_PAGE_MAX_LIMIT=20
ADVERT_PRICE_MIN=1
ADVERT_PRICE_MAX=9999
ADVERT_TITLE_MAX_LENGTH=50
ADVERT_DESCRIPTION_MAX_LENGTH=500