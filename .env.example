# Copy this to .env.development or .env.production
# Never commit your .env files to git!

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Server
PORT=3000

# Uploads (max image file size in MB)
UPLOAD_DIR="uploads"
UPLOAD_MAX_FILE_SIZE=5

# JSON authentication
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"
JWT_EXPIRES_IN="24h"

# Advert constraints
ADVERT_MIN_PAGE=1
ADVERT_MAX_PAGE_LIMIT=20
ADVERT_MIN_PRICE=1
ADVERT_MAX_PRICE=9999
ADVERT_MAX_TITLE_LENGTH=50
ADVERT_MAX_DESCRIPTION_LENGTH=500